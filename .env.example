# Copy this file to .env.local. Only public values belong here.

# Data mode (explicit, never a silent fallback):
#   supabase = real project (Auth + Postgres + private Storage). Missing keys below are a hard error.
#   mock     = read-only demo data from src/lib/contracts/fixtures.ts, no sign-in, nothing is saved.
# If this line is omitted: "supabase" when the two keys below are set, otherwise "mock".
NEXT_PUBLIC_DATA_MODE=supabase

# Project URL and the public (anon / publishable) key from Supabase > Project Settings > API.
# Local stack (npx supabase start): http://127.0.0.1:54321 and the anon key printed by `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Never add SUPABASE_SERVICE_ROLE_KEY to a browser-facing env, to NEXT_PUBLIC_*, or to git.
# The app does not need it: every operation runs as the signed-in user and is limited by Row Level Security.
